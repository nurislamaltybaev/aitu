# OPTIONAL for the desktop client. Jarvis_Portable.exe runs without this file; it only overrides the built-in
# defaults. No API keys belong here: the OpenRouter key lives on the server (server/.env.example).
# Server address (also: Jarvis_Portable.exe --server https://...).
JARVIS_SERVER=
# Only if the server sets JARVIS_CLIENT_TOKEN.
JARVIS_TOKEN=
# Model preselected in the start-up picker (the server decides which models are allowed).
JARVIS_MODEL=anthropic/claude-haiku-5.5
# Voice (Ctrl+Alt+V). Languages tried for speech recognition, spoken results on/off (1/0),
# and the microphone loudness that counts as speech (raise in a noisy room, lower for a quiet voice).
JARVIS_VOICE_LANGS=ru-RU,en-US
JARVIS_TTS=1
JARVIS_MIC_THRESHOLD=500
# Optional: TickTick tasks tagged "jarvis" are offered as commands.
TICKTICK_TOKEN=
