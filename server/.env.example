# Copy to server/.env for a local run, or set these as environment variables on the host (Render, etc.).
# Required: the OpenRouter key. It lives ONLY here; the desktop client never sees it.
OPENROUTER_API_KEY=
# Models clients may request (comma separated). Anything else is refused, so nobody can bill you for a pricey model.
JARVIS_ALLOWED_MODELS=openai/gpt-6-luna,anthropic/claude-haiku-5.5,google/gemini-2.5-flash
# Optional shared secret. If set, put the same value into CLIENT_TOKEN in vision_client.py before building the exe.
JARVIS_CLIENT_TOKEN=
# Optional: web search for the model (Brave Search API key).
BRAVE_API_KEY=
# Optional: reply size cap in tokens (long typed answers need more).
JARVIS_MAX_TOKENS=4096
